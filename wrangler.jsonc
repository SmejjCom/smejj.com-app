{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "smejj-com",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "SMEJJ_LLM_BASE_URL": "https://api.moonshot.ai/v1",
    "SMEJJ_LLM_MODEL": "kimi-k2.7-code"
  },
  "routes": [
    {
      "pattern": "smejj.com",
      "custom_domain": true
    },
    {
      "pattern": "www.smejj.com",
      "custom_domain": true
    }
  ]
}
