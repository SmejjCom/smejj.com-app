{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "smejj-com",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "SMEJJ_LLM_BASE_URL": "disabled",
    "SMEJJ_LLM_MODEL": "disabled",
    "GOOGLE_CLIENT_ID": "457164842646-pgnrulbj893hlahhjijank4bd6o8n0as.apps.googleusercontent.com",
    "GOOGLE_ALLOWED_EMAIL": "smejjcom@gmail.com"
  },
  "routes": [
    {
      "pattern": "smejj.com",
      "custom_domain": true
    },
    {
      "pattern": "www.smejj.com",
      "custom_domain": true
    }
  ]
}
