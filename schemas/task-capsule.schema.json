{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/task-capsule.schema.json",
  "title": "smejj.com Task Capsule",
  "type": "object",
  "required": [
    "schemaVersion",
    "jobId",
    "projectId",
    "createdAt",
    "policy",
    "model",
    "objects",
    "verification",
    "memory"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "jobId": {
      "type": "string"
    },
    "projectId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "policy": {
      "type": "object",
      "required": [
        "replayable",
        "rollbackBeforePatch",
        "blindFullRepoLoadAllowed",
        "testsAreTruth"
      ],
      "additionalProperties": false,
      "properties": {
        "replayable": {
          "const": true
        },
        "rollbackBeforePatch": {
          "const": true
        },
        "blindFullRepoLoadAllowed": {
          "const": false
        },
        "testsAreTruth": {
          "const": true
        }
      }
    },
    "model": {
      "type": "object",
      "required": [
        "id",
        "effort",
        "inferenceDefault"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "glm-5-2"
        },
        "effort": {
          "type": "string"
        },
        "inferenceDefault": {
          "const": "disabled-until-explicit-compute-approval"
        }
      }
    },
    "objects": {
      "type": "object",
      "required": [
        "input",
        "budget",
        "contextPlan",
        "repoPack",
        "promptBlocks",
        "patch",
        "testResults",
        "browserResults",
        "screenshots",
        "errors",
        "selfFixAttempts",
        "verifierReport",
        "benchmarkResults",
        "rollbackManifest",
        "finalAnswer"
      ],
      "additionalProperties": false,
      "properties": {
        "input": {
          "type": "string"
        },
        "budget": {
          "type": "string"
        },
        "contextPlan": {
          "type": "string"
        },
        "repoPack": {
          "type": "string"
        },
        "promptBlocks": {
          "type": "string"
        },
        "patch": {
          "type": "string"
        },
        "testResults": {
          "type": "string"
        },
        "browserResults": {
          "type": "string"
        },
        "screenshots": {
          "type": "string"
        },
        "errors": {
          "type": "string"
        },
        "selfFixAttempts": {
          "type": "string"
        },
        "verifierReport": {
          "type": "string"
        },
        "benchmarkResults": {
          "type": "string"
        },
        "rollbackManifest": {
          "type": "string"
        },
        "finalAnswer": {
          "type": "string"
        }
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "required",
        "selfFixMaxAttempts"
      ],
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "selfFixMaxAttempts": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "memory": {
      "type": "object",
      "required": [
        "learnDirectlyFromModelOutput",
        "proposalKey"
      ],
      "additionalProperties": false,
      "properties": {
        "learnDirectlyFromModelOutput": {
          "const": false
        },
        "proposalKey": {
          "type": "string"
        }
      }
    }
  }
}
