# smejj.com — schlankes Control-Server-Image: alles Unnoetige/Sensible ausschliessen.
node_modules
.git
.env
.env.*
backups
tmp
tests
# "scripts/*" statt "scripts": schliesst genauso alles aus, erlaubt aber gezielte
# Ausnahmen darunter (Docker ignoriert Negationen, wenn schon das Verzeichnis
# selbst ausgeschlossen ist). Der Control-Server kopiert scripts/ ohnehin nicht.
scripts/*
!scripts/evaluation
!scripts/evaluation/run_model_eval.mjs
idrive-layout
examples
workers/*
!workers/remote-browser
!workers/remote-browser/**
!workers/smejj-worker
!workers/smejj-worker/**
!workers/maus-engine
!workers/maus-engine/**
!workers/glm-salad
!workers/glm-salad/s3.js
!workers/smejj-training-loop
!workers/smejj-training-loop/**
schemas/*
# Beide Maus-Schemata werden zur LAUFZEIT per fs gelesen (plan-validator und
# interactive-loop). Fehlt eines im Abbild, bootet der Dienst zwar, aber der
# erste Maus-Lauf endet in ENOENT. Verbindliche Liste:
# scripts/deploy/release-include-paths.mjs (CONTROL_RELEASE_RUNTIME_RESOURCES).
!schemas/maus-action-plan.schema.json
!schemas/maus-step-decision.schema.json
*.xlsx
.DS_Store
