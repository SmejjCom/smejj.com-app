# smejj.com — schlankes Control-Server-Image: alles Unnoetige/Sensible ausschliessen.
node_modules
.git
.env
.env.*
backups
tmp
tests
# "scripts/*" statt "scripts": schliesst genauso alles aus, erlaubt aber gezielte
# Ausnahmen darunter (Docker ignoriert Negationen, wenn schon das Verzeichnis
# selbst ausgeschlossen ist). Der Control-Server kopiert scripts/ ohnehin nicht.
scripts/*
!scripts/evaluation
!scripts/evaluation/run_model_eval.mjs
# BEFUND 2026-09-05: Autopilot Nr. 82 (Schutz-Echtheit) laedt seine Pruefsaetze
# aus scripts/check-schutz-echtheit.mjs. Ohne diese Ausnahme fehlt die Datei im
# Abbild, der Control-Server startet nicht mehr — api.smejj.com antwortete rund
# eine Stunde mit 502. Der erste Reparaturversuch scheiterte am Bau selbst,
# weil hier die Ausnahme fehlte und COPY die Datei gar nicht sah.
!scripts/check-schutz-echtheit.mjs
idrive-layout
examples
workers/*
!workers/process-crash-guard.mjs
!workers/remote-browser
!workers/remote-browser/**
!workers/smejj-worker
!workers/smejj-worker/**
!workers/smejj-smee
!workers/smejj-smee/**
!workers/maus-engine
!workers/maus-engine/**
!workers/glm-salad
!workers/glm-salad/s3.js
!workers/smejj-bild-maler
!workers/smejj-bild-maler/**
!workers/smejj-video-worker
!workers/smejj-video-worker/**
!workers/smejj-training-loop
!workers/smejj-training-loop/**
# Bruecken-Waechter (eigener Dienst seit 2026-08-07). OHNE diese zwei
# Zeilen scheitert der Docker-Bau mit "failed to calculate checksum of ref"
# — die Falle, die schon den Training-Loop einen Ship-Loop gekostet hat.
!workers/smejj-brueckenwaechter
!workers/smejj-brueckenwaechter/**
!workers/smejj-autopilot-jobs
!workers/smejj-autopilot-jobs/**
# Anbau der Dauertrainings-Schleife. OHNE diese beiden Zeilen bricht der Bau ab:
# "failed to compute cache key" bei COPY workers/smejj-lora-loop — der Ordner
# liegt dann gar nicht im Bau-Kontext. Live gemessen am 2026-08-01
# (deployment-6a6d95059cd65e28a34344dd). Wer hier einen Worker ergaenzt, MUSS
# ihn auch hier freistellen; `workers/*` schliesst sonst alles Neue stumm aus.
!workers/smejj-lora-loop
!workers/smejj-lora-loop/**
schemas/*
# Beide Maus-Schemata werden zur LAUFZEIT per fs gelesen (plan-validator und
# interactive-loop). Fehlt eines im Abbild, bootet der Dienst zwar, aber der
# erste Maus-Lauf endet in ENOENT. Verbindliche Liste:
# scripts/deploy/release-include-paths.mjs (CONTROL_RELEASE_RUNTIME_RESOURCES).
!schemas/maus-action-plan.schema.json
!schemas/maus-step-decision.schema.json
*.xlsx
.DS_Store
# Hausmodell-Dienst (eigener Dienst seit 2026-09-01). Ohne diese zwei Zeilen
# bricht der Docker-Bau mit "failed to calculate checksum of ref" ab — dieselbe
# Falle, die schon Training-Loop und Bruecken-Waechter je einen Anlauf kostete.
!workers/smejj-hausmodell
!workers/smejj-hausmodell/**
# con-Autopilot (eigener Zeabur-Dienst seit 2026-09-03). Ohne diese Zeilen scheitert der Docker-Bau
# mit "failed to calculate checksum of ref" — dieselbe Falle wie beim Training-Loop.
!workers/con-autopilot
!workers/con-autopilot/**
