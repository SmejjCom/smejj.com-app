          "values": [
            "391"
          ],
          "critical": true
        }
      ]
    },
    {
      "id": "mathe-gleichung",
      "profile": "reasoning",
      "weight": 1,
      "maxTokens": 60,
      "system": "Antworte nur mit dem Wert von x.",
      "prompt": "Loese: 3x + 7 = 22",
      "assertions": [
        {
          "type": "matches",
          "pattern": "(^|[^\\d.,])5([^\\d.,]|$)",
          "critical": true
        },
        {
          "type": "not_matches",
          "pattern": "(^|[^\\d.,])(4|6|15)([^\\d.,]|$)"
        }
      ]
    },
    {
      "id": "logik-syllogismus",
      "profile": "reasoning",
      "weight": 1,
      "maxTokens": 40,
      "system": "Antworte nur mit Ja oder Nein.",
      "prompt": "Alle Katzen sind Saeugetiere. Mimi ist eine Katze. Ist Mimi ein Saeugetier?",
      "assertions": [
        {
          "type": "matches",
          "pattern": "^\\W*ja\\b",
          "critical": true,
          "ignoreCase": true
        },
        {
          "type": "not_matches",
          "pattern": "\\bnein\\b",
          "ignoreCase": true
        }
      ]
    },
    {
      "id": "planung-reihenfolge",
      "profile": "reasoning",
      "weight": 2,
      "maxTokens": 60,
      "system": "Antworte nur mit den Buchstaben in der richtigen Reihenfolge, durch Kommas getrennt.",
      "prompt": "Bringe die Schritte fuer Tee in die richtige Reihenfolge: A) Tee ziehen lassen, B) Wasser kochen, C) Teebeutel in die Tasse legen, D) Wasser in die Tasse giessen.",
      "assertions": [
        {
          "type": "matches",
          "pattern": "B\\W*[CD]\\W*[CD]\\W*A",
          "critical": true
        }
      ]
    },
