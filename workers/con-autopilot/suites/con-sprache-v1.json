            "laenger",
            "länger",
            "20 Uhr"
          ],
          "critical": true
        },
        {
          "type": "contains_any",
          "values": [
            "Bibliothek",
            "Stadtbibliothek"
          ]
        },
        {
          "type": "not_matches",
          "pattern": "[.!?]\\s+[A-ZÄÖÜ][^.!?]*[.!?]\\s+[A-ZÄÖÜ]"
        },
        {
          "type": "max_length",
          "value": 300
        }
      ]
    },
