# smejj.com voice worker — example environment (NO real secrets here).
# Copy to Salad secrets / protected env at deploy time. Nothing is baked into
# the image. The worker is fail-closed: it refuses to start unless the budget
# gate below is fully configured and approved.

# =========================================================================== #
# 1) BUDGET GATE (fail-closed) — SAME keys as control-server budgetGate.js.    #
#    All five together keep spend inside the approved <= 10 USD/month envelope.#
# =========================================================================== #
# Hard per-run USD cap. This voice worker's requested budget must be <= this.
SMEJJ_BUDGET_MAX_USD_PER_JOB=0.05
# Hard runtime cap in minutes. Also the worker's own runtime fuse and the SAME
# key the control-server watchdog lease enforces. Must be > 0 and <= 1440 (24h).
SMEJJ_BUDGET_MAX_RUNTIME_MINUTES=20
# Max concurrent voice workers the budget allows.
SMEJJ_BUDGET_MAX_CONCURRENT_WORKERS=1
# This worker's requested budget (must be positive and <= MAX_USD_PER_JOB).
SMEJJ_WORKER_BUDGET_USD=0.03
# Estimated runtime for this worker (must be positive and <= MAX_RUNTIME_MINUTES).
SMEJJ_WORKER_ESTIMATED_RUNTIME_MINUTES=15

# =========================================================================== #
# 2) IDLE AUTO-SHUTDOWN (cost fuse) — self-terminate when nobody is talking.   #
# =========================================================================== #
# Seconds with NO active voice session before the worker shuts itself down.
SMEJJ_VOICE_IDLE_SHUTDOWN_SECONDS=120
# How often (seconds) the lifecycle supervisor checks idle/runtime.
SMEJJ_VOICE_LIFECYCLE_POLL_SECONDS=5

# =========================================================================== #
# 3) MODEL ROUTER (OpenAI-compatible, BYOK) — smejj.com router endpoint.       #
#    Canonical keys match modelRouter.js custom backend. Never commit a key.   #
# =========================================================================== #
SMEJJ_LLM_BASE_URL=https://router.smejj.com/v1
SMEJJ_LLM_API_KEY=replace_me
# Requested model id (router resolves the actual backend). Default: glm-5.2.
SMEJJ_LLM_MODEL=glm-5.2
# Optional: override the language-agnostic system prompt.
# SMEJJ_VOICE_SYSTEM_PROMPT=
SMEJJ_LLM_TIMEOUT_SECS=45

# =========================================================================== #
# 4) SPEECH-TO-TEXT — faster-whisper large-v3, auto-detect EVERY language.     #
# =========================================================================== #
SMEJJ_WHISPER_MODEL=large-v3
SMEJJ_WHISPER_DEVICE=cuda
SMEJJ_WHISPER_COMPUTE=float16
# Leave blank / "auto" => detect the spoken language automatically (all langs).
# Set a code (e.g. de, en, tr) ONLY to force a single language.
SMEJJ_WHISPER_LANGUAGE=auto

# =========================================================================== #
# 5) TEXT-TO-SPEECH — Piper HTTP default (natural neural). XTTS-v2 compatible. #
# =========================================================================== #
# piper (default) | xtts  (xtts is natively multilingual per detected language)
SMEJJ_TTS_ENGINE=piper
# Self-hosted TTS HTTP server (free-only: no third-party voice service).
SMEJJ_TTS_BASE_URL=http://127.0.0.1:5000
SMEJJ_TTS_VOICE=en_US-amy-medium
SMEJJ_TTS_DEFAULT_LANGUAGE=en
SMEJJ_TTS_SAMPLE_RATE=22050
# XTTS only: speak in the Whisper-detected language automatically.
SMEJJ_TTS_FOLLOW_LANGUAGE=true

# =========================================================================== #
# 6) VOICE ACTIVITY DETECTION (Silero VAD) — barge-in thresholds.             #
# =========================================================================== #
SMEJJ_VAD_CONFIDENCE=0.7
SMEJJ_VAD_START_SECS=0.2
SMEJJ_VAD_STOP_SECS=0.8
SMEJJ_VAD_MIN_VOLUME=0.6

# =========================================================================== #
# 7) TRANSPORT / RUNTIME.                                                      #
# =========================================================================== #
SMEJJ_HOST=0.0.0.0
SMEJJ_WORKER_PORT=8080
SMEJJ_SAMPLE_RATE=16000
SMEJJ_LOG_LEVEL=info
