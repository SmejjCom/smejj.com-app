PORT=3000
PROJECT_ROOT=.

# AI is disabled by default. Use an explicit BYOK or local OpenAI-compatible endpoint only after approval.
SMEJJ_LLM_BASE_URL=disabled
SMEJJ_LLM_API_KEY=replace_me
SMEJJ_LLM_MODEL=disabled

# Google Login. Create an OAuth Web Client for https://smejj.com.
GOOGLE_CLIENT_ID=replace_me.apps.googleusercontent.com
GOOGLE_ALLOWED_EMAIL=smejjcom@gmail.com
SMEJJ_SESSION_SECRET=replace_with_long_random_secret

# For local llama.cpp/Ollama-style tests, use for example:
# SMEJJ_LLM_BASE_URL=http://127.0.0.1:8080/v1
# SMEJJ_LLM_API_KEY=local
# SMEJJ_LLM_MODEL=unsloth/Kimi-K2.7-Code-GGUF:UD-Q4_K_XL

# IDrive e2 / S3-compatible storage. Never commit real values.
IDRIVE_E2_ENDPOINT=https://s3.us-west-2.idrivee2.com
IDRIVE_E2_REGION=us-west-2
IDRIVE_E2_ACCESS_KEY=
IDRIVE_E2_SECRET_KEY=
IDRIVE_E2_BUCKET=smejj-model-files

# Model transfer safety settings.
HF_MODEL_REPO=moonshotai/Kimi-K2.7-Code
MODEL_TMP_DIR=/tmp/smejj-model-files/kimi-k2-7
MODEL_S3_PREFIX=model-files/kimi-k2-7
CONFIRM_MODEL_DOWNLOAD=NO
CONFIRM_IDRIVE_UPLOAD=NO
