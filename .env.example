PORT=3000
PROJECT_ROOT=.

# AI is disabled by default. Use an explicit BYOK or local OpenAI-compatible endpoint only after approval.
SMEJJ_LLM_BASE_URL=disabled
SMEJJ_LLM_API_KEY=replace_me
SMEJJ_LLM_MODEL=disabled

# Multi-Modell-Router (control-server/src/llm/modelRouter.js), Prioritaet: Salad -> OpenRouter -> Custom.
# Salad = eigener GPU-Endpoint (Container Gateway, z. B. smejj-llm-qwen3 / TGI).
SMEJJ_LLM_SALAD_BASE_URL=
SMEJJ_LLM_SALAD_API_KEY=
SMEJJ_LLM_SALAD_MODEL=tgi
# OpenRouter = Multi-Modell-Fallback (GPT, Claude, Gemini, DeepSeek, Kimi, GLM, ...).
SMEJJ_LLM_OPENROUTER_API_KEY=
SMEJJ_LLM_OPENROUTER_MODEL_CODING=
SMEJJ_LLM_OPENROUTER_MODEL_REASONING=
SMEJJ_LLM_OPENROUTER_MODEL_FAST=

# Optional aliases for OpenAI-compatible providers. Still BYOK: no hidden platform billing.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Google Login. Create an OAuth Web Client for https://smejj.com.
GOOGLE_CLIENT_ID=replace_me.apps.googleusercontent.com
GOOGLE_ALLOWED_EMAIL=smejjcom@gmail.com
SMEJJ_SESSION_SECRET=replace_with_long_random_secret

# For local llama.cpp/Ollama-style tests, use for example:
# SMEJJ_LLM_BASE_URL=http://127.0.0.1:8080/v1
# SMEJJ_LLM_API_KEY=local
# SMEJJ_LLM_MODEL=unsloth/Kimi-K2.7-Code-GGUF:UD-Q4_K_XL

# IDrive e2 / S3-compatible storage. Never commit real values.
IDRIVE_E2_ENDPOINT=https://s3.us-west-2.idrivee2.com
IDRIVE_E2_REGION=us-west-2
IDRIVE_E2_ACCESS_KEY=
IDRIVE_E2_SECRET_KEY=
IDRIVE_E2_BUCKET=smejj-model-files
IDRIVE_E2_STATUS_TIMEOUT_MS=2500

# Model transfer safety settings.
HF_MODEL_REPO=moonshotai/Kimi-K2.7-Code
MODEL_TMP_DIR=/tmp/smejj-model-files/kimi-k2-7
MODEL_S3_PREFIX=model-files/kimi-k2-7
CONFIRM_MODEL_DOWNLOAD=NO
CONFIRM_IDRIVE_UPLOAD=NO

# Verified GLM 5.2 FP8 vault prefix. Storage-only unless a larger approved compute path passes preflight.
GLM_5_2_FP8_PREFIX=model-files/glm-5-2-fp8/original/

# Salad default worker planning values. These are preflight facts, not permission to deploy.
SALAD_WORKER_GPU_COUNT=1
SALAD_WORKER_GPU_VRAM_GB=24
SALAD_WORKER_VCPU=16
SALAD_WORKER_RAM_GB=64
SALAD_WORKER_LOCAL_CACHE_GB=300
SALAD_QUOTA_REMAINING_REPLICAS=10

# SaladCloud operator API (never commit real values)
SALAD_API_KEY=
SALAD_ORGANIZATION_NAME=
SALAD_PROJECT_NAME=
SALAD_CONTAINER_GROUP_NAME=smejj-glm-worker
SALAD_GLM_WORKER_IMAGE=
SALAD_GPU_CLASS_IDS=
SALAD_WORKER_MEMORY_MB=65536
SALAD_WORKER_STORAGE_BYTES=805306368000
SALAD_WORKER_PORT=8080
SALAD_WORKER_MODE=planner-vault
SMEJJ_CONTROL_ROUTER_URL=https://smejj.com

# GLM Salad worker runtime. Keep NO until a verified GPU container is intentionally started.
SMEJJ_WORKER_PORT=8080
SMEJJ_GLM_RUNTIME=sglang
SMEJJ_MODEL_CACHE_DIR=/cache/glm-5-2-fp8
SMEJJ_START_GLM_RUNTIME=NO
SMEJJ_GLM_RUNTIME_BASE_URL=
CONFIRM_SALAD_CREATE=NO
CONFIRM_SALAD_START=NO
CONFIRM_SALAD_STOP=NO

# Budget gate (fail-closed). Without positive caps AND a declared worker budget,
# the control server refuses to create or start any Salad worker (HTTP 402).
SMEJJ_BUDGET_MAX_USD_PER_JOB=
SMEJJ_BUDGET_MAX_RUNTIME_MINUTES=
SMEJJ_BUDGET_MAX_CONCURRENT_WORKERS=1
SMEJJ_WORKER_BUDGET_USD=
SMEJJ_WORKER_ESTIMATED_RUNTIME_MINUTES=

# Worker callback auth (fail-closed). Workers sign POST /api/jobs/{id}/status with
# hex(hmac-sha256(secret, "<timestamp_ms>.<raw_body>")) in x-smejj-worker-signature
# plus x-smejj-worker-timestamp. Without this secret all callbacks are rejected (503).
SMEJJ_WORKER_CALLBACK_SECRET=

# Autonomous loop (fail-closed). Both values are required before POST
# /api/jobs/{id}/autonomous-run does anything. Dispatch contract:
# POST {jobId, attempt, maxAttempts, task, previousErrors} -> {ok, errors?, memoryUpdate?}
SMEJJ_AUTONOMOUS_LOOP_ENABLED=NO
SMEJJ_WORKER_DISPATCH_URL=
