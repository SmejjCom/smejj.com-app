PORT=3000
PROJECT_ROOT=.

# Secrets must live outside a cloud-synchronized workspace. The default is
# ~/.config/smejj.com/env.local; an override must be an absolute local path.
SMEJJ_LOCAL_ENV_FILE=

# AI is disabled by default. Use an explicit BYOK or local OpenAI-compatible endpoint only after approval.
SMEJJ_LLM_BASE_URL=disabled
SMEJJ_LLM_API_KEY=replace_me
SMEJJ_LLM_MODEL=disabled

# Multi-Modell-Router (control-server/src/llm/modelRouter.js), Prioritaet: Salad -> OpenRouter -> Custom.
# GLM-5.2 bleibt Standard. Kimi K2.7 ist nur mit Feature-Flag aktiv und faellt
# bei fehlender Runtime oder Ausfall kontrolliert auf GLM-5.2 zurueck.
SMEJJ_MODEL_DEFAULT=glm-5-2
SMEJJ_GLM_5_2_ENABLED=YES
SMEJJ_KIMI_K2_7_ENABLED=NO
SMEJJ_MODEL_FALLBACK_ENABLED=YES
SMEJJ_MODEL_AUTO_ENABLED=NO
SMEJJ_LLM_TIMEOUT_MS=120000
# Salad = eigener GPU-Endpoint (Container Gateway, z. B. smejj-llm-qwen3 / TGI).
SMEJJ_LLM_SALAD_BASE_URL=
SMEJJ_LLM_SALAD_API_KEY=
SMEJJ_LLM_SALAD_MODEL=tgi
# OpenRouter = Multi-Modell-Fallback (GPT, Claude, Gemini, DeepSeek, Kimi, GLM, ...).
SMEJJ_LLM_OPENROUTER_API_KEY=
SMEJJ_LLM_OPENROUTER_MODEL_CODING=
SMEJJ_LLM_OPENROUTER_MODEL_REASONING=
SMEJJ_LLM_OPENROUTER_MODEL_FAST=

# GLM 5.2 als Fundament (Zhipu, OpenAI-kompatibel). BYOK: Key traegt der Nutzer ein.
# Mit gesetztem Key + Provider-Order wird GLM 5.2 primaeres Modell, Salad bleibt Fallback.
# Anleitung: docs/deployment/GLM_5_2_AKTIVIERUNG_2026-07-09.md
SMEJJ_LLM_ZHIPU_API_KEY=
SMEJJ_LLM_ZHIPU_BASE_URL=https://api.z.ai/api/paas/v4
SMEJJ_LLM_ZHIPU_MODEL=glm-5.2
SMEJJ_LLM_PROVIDER_ORDER=

# Kimi K2.7: offizieller OpenAI-kompatibler Endpoint; alternativ kann ein
# separat genehmigter Self-Hosted-Endpoint mit exaktem Served-Model-Namen
# verwendet werden.
# IDrive e2 speichert die Gewichte, fuehrt aber keine Inferenz aus.
SMEJJ_LLM_KIMI_BASE_URL=https://api.moonshot.ai/v1
SMEJJ_LLM_KIMI_API_KEY=
SMEJJ_LLM_KIMI_MODEL=kimi-k2.7-code
SMEJJ_LLM_KIMI_HEADER=Authorization

# Kimi K3 — NUR API, kein Vault in IDrive e2 (Gewichte ~594 GB bis 1,4 TB und
# nur auf einem Mehr-Knoten-GPU-Cluster lauffaehig; ein e2-Abzug brachte keine
# Laufzeit). Key holen: https://platform.kimi.ai — eigenes Konto, getrennt vom
# Chat-Login auf kimi.com. Der Endpunkt bleibt api.moonshot.ai.
# KOSTENPFLICHTIG: bleibt ohne Flag + Key inaktiv, GLM-5.2 bleibt Standard.
# KEY-ERBE: ist SMEJJ_LLM_KIMI_K3_API_KEY leer, nutzt K3 den K2.7-Key oben
# (dasselbe Moonshot-Konto). In der Regel reicht daher das Flag allein.
# Ein eigener K3-Key hat Vorrang — etwa um die Kosten getrennt abzurechnen.
SMEJJ_KIMI_K3_ENABLED=NO
SMEJJ_LLM_KIMI_K3_BASE_URL=https://api.moonshot.ai/v1
SMEJJ_LLM_KIMI_K3_API_KEY=
SMEJJ_LLM_KIMI_K3_MODEL=kimi-k3
SMEJJ_LLM_KIMI_K3_HEADER=Authorization
# Denktiefe von K3 (low|high|max). K3 denkt immer, abschalten geht nicht — nur
# die Tiefe ist steuerbar. LEER = Regel aus src/ai/reasoningEffortPolicy.js:
# Coding und Reasoning behalten die volle Tiefe, alles andere bekommt "low".
# Ein fester Wert hier uebersteuert die Regel (Messen, Notbremse).
SMEJJ_LLM_KIMI_K3_REASONING_EFFORT=

# Live-Chat-Bridge: Control Server als gemeinsamer Modell-Layer; direkte GLM-
# Verbindung der Bridge bleibt bei Router-Ausfall als stabiler Notfallpfad.
SMEJJ_MULTI_MODEL_ROUTER_ENABLED=NO

# Optional aliases for OpenAI-compatible providers. Still BYOK: no hidden platform billing.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Google Login. Create an OAuth Web Client for https://smejj.com.
GOOGLE_CLIENT_ID=replace_me.apps.googleusercontent.com
GOOGLE_ALLOWED_EMAIL=smejjcom@gmail.com
SMEJJ_SESSION_SECRET=replace_with_long_random_secret

# GitHub Login (eigene OAuth-App, getrennt vom Repo-Publisher SMEJJ_GITHUB_APP_*).
# GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App.
# Authorization callback URL: https://<control-server-origin>/api/auth/github/callback
# Fail-closed: ohne Client-ID/Secret bleibt der GitHub-Button ausgeblendet.
SMEJJ_GITHUB_LOGIN_CLIENT_ID=
SMEJJ_GITHUB_LOGIN_CLIENT_SECRET=
# Optional: auf ein einzelnes Konto beschraenken (leer = jedes verifizierte Konto).
SMEJJ_GITHUB_LOGIN_ALLOWED_EMAIL=
# Magic Link (passwortlos) nutzt die SMEJJ_SMTP_* Mailer-Konfiguration weiter unten.

# User-owned provider credential vault (Cline and future providers).
# Generate one 32-byte base64 key outside this synchronized workspace and keep
# both values only in ~/.config/smejj.com/env.local or the runtime secret store.
SMEJJ_PROVIDER_CREDENTIAL_KEY_ID=
SMEJJ_PROVIDER_CREDENTIAL_KEY_B64=
# Master key rotation: set the previous key here so stored credentials stay
# readable; they are re-encrypted with the current key on next read.
SMEJJ_PROVIDER_CREDENTIAL_PREVIOUS_KEY_ID=
SMEJJ_PROVIDER_CREDENTIAL_PREVIOUS_KEY_B64=
# Dev only: allow non-durable encrypted in-memory credential storage when
# IDrive e2 is not configured. Never set this in production (fail-closed).
SMEJJ_PROVIDER_CREDENTIAL_ALLOW_MEMORY=

# For local llama.cpp/Ollama-style tests, use for example:
# SMEJJ_LLM_BASE_URL=http://127.0.0.1:8080/v1
# SMEJJ_LLM_API_KEY=local
# SMEJJ_LLM_MODEL=unsloth/Kimi-K2.7-Code-GGUF:UD-Q4_K_XL

# E-Mail-/Passwort-Auth. Optionale Registrierungs-Allowlist (Komma-getrennt);
# leer = offen. Ohne SMTP-Konfiguration ist der Mailversand fail-closed deaktiviert
# und die E-Mail-Verifikation wird nicht erzwungen.
SMEJJ_AUTH_ALLOWED_EMAILS=
SMEJJ_SMTP_HOST=
SMEJJ_SMTP_PORT=465
SMEJJ_SMTP_USER=
SMEJJ_SMTP_PASS=
SMEJJ_SMTP_FROM=

# Admin console (stage 1, read-only). Comma-separated e-mail addresses that are
# treated as "owner" even when the stored account record says otherwise. This is
# the bootstrap path for the very first admin — every other role is granted in
# the console itself. Leave empty in environments that must have no admin.
SMEJJ_ADMIN_OWNER_EMAILS=

# IDrive e2 / S3-compatible storage. Never commit real values.
IDRIVE_E2_ENDPOINT=https://s3.us-west-2.idrivee2.com
IDRIVE_E2_REGION=us-west-2
IDRIVE_E2_ACCESS_KEY=
IDRIVE_E2_SECRET_KEY=
IDRIVE_E2_BUCKET=smejj-model-files
IDRIVE_E2_MODEL_BUCKET=smejj-model-files
IDRIVE_E2_STATUS_TIMEOUT_MS=2500

# Model transfer safety settings.
HF_MODEL_REPO=moonshotai/Kimi-K2.7-Code
MODEL_TMP_DIR=/tmp/smejj-model-files/kimi-k2-7
MODEL_S3_PREFIX=model-files/kimi-k2-7
CONFIRM_MODEL_DOWNLOAD=NO
CONFIRM_IDRIVE_UPLOAD=NO

# Verified GLM 5.2 FP8 vault prefix. Storage-only unless a larger approved compute path passes preflight.
GLM_5_2_FP8_PREFIX=model-files/glm-5-2-fp8/original/

# Salad default worker planning values. These are preflight facts, not permission to deploy.
SALAD_WORKER_GPU_COUNT=1
SALAD_WORKER_GPU_VRAM_GB=24
SALAD_WORKER_VCPU=16
SALAD_WORKER_RAM_GB=64
SALAD_WORKER_LOCAL_CACHE_GB=300
SALAD_QUOTA_REMAINING_REPLICAS=10

# SaladCloud operator API (never commit real values)
SALAD_API_KEY=
SALAD_ORGANIZATION_NAME=
SALAD_PROJECT_NAME=
SALAD_CONTAINER_GROUP_NAME=smejj-glm-worker
SALAD_GLM_WORKER_IMAGE=
SALAD_GPU_CLASS_IDS=
SALAD_WORKER_MEMORY_MB=65536
SALAD_WORKER_STORAGE_BYTES=805306368000
SALAD_WORKER_PORT=8080
SALAD_WORKER_MODE=planner-vault
SMEJJ_CONTROL_ROUTER_URL=https://smejj.com

# Passkeys/WebAuthn — Relying Party. Standard smejj.com; fuer lokale Tests localhost.
# SMEJJ_SESSION_SECRET wird als Challenge-Signaturschluessel wiederverwendet (Pflicht).
SMEJJ_PASSKEY_RP_ID=smejj.com
SMEJJ_PASSKEY_RP_NAME=smejj.com

# Integrierter Browser (Codex-Stil) — Rate-Limit fuer /api/browser/fetch pro Client-IP.
# Standard: 20 Burst, 0,5/s Nachfuellung (~30 Anfragen/min). Verhindert offenen Proxy-Missbrauch.
SMEJJ_BROWSER_RATE_CAPACITY=20
SMEJJ_BROWSER_RATE_REFILL_PER_SEC=0.5

# GLM Salad worker runtime. Keep NO until a verified GPU container is intentionally started.
SMEJJ_WORKER_PORT=8080
SMEJJ_GLM_RUNTIME=sglang
SMEJJ_MODEL_CACHE_DIR=/cache/glm-5-2-fp8
SMEJJ_START_GLM_RUNTIME=NO
SMEJJ_GLM_RUNTIME_BASE_URL=
CONFIRM_SALAD_CREATE=NO
CONFIRM_SALAD_START=NO
CONFIRM_SALAD_STOP=NO
SMEJJ_SALAD_WATCHDOG_RECOVERY_ENABLED=NO
SALAD_API_TIMEOUT_MS=10000

# Dedicated least-privilege IDrive e2 principal for append-only Salad watchdog
# leases. General or training-storage credentials are never used as fallback.
IDRIVE_E2_WATCHDOG_ENDPOINT=https://s3.us-west-2.idrivee2.com
IDRIVE_E2_WATCHDOG_REGION=us-west-2
IDRIVE_E2_WATCHDOG_ACCESS_KEY=
IDRIVE_E2_WATCHDOG_SECRET_KEY=
IDRIVE_E2_WATCHDOG_BUCKET=smejj-app
IDRIVE_E2_WATCHDOG_ALLOWED_PREFIX=workers/salad/watchdogs/
IDRIVE_E2_WATCHDOG_TIMEOUT_MS=5000

# Budget gate (fail-closed). Without positive caps AND a declared worker budget,
# the control server refuses to create or start any Salad worker (HTTP 402).
SMEJJ_BUDGET_MAX_USD_PER_JOB=
SMEJJ_BUDGET_MAX_RUNTIME_MINUTES=
SMEJJ_BUDGET_MAX_CONCURRENT_WORKERS=1
SMEJJ_BUDGET_MAX_GLOBAL_RESERVED_USD=
SMEJJ_WORKER_BUDGET_USD=
SMEJJ_WORKER_ESTIMATED_RUNTIME_MINUTES=

# Worker callback auth (fail-closed). Workers sign POST /api/jobs/{id}/status with
# hex(hmac-sha256(secret, "<timestamp_ms>.<raw_body>")) in x-smejj-worker-signature
# plus x-smejj-worker-timestamp. Without this secret all callbacks are rejected (503).
SMEJJ_WORKER_CALLBACK_SECRET=

# Autonomous loop (fail-closed). Both values are required before POST
# /api/jobs/{id}/autonomous-run does anything. Dispatch contract:
# POST {jobId, attempt, maxAttempts, task, previousErrors} -> {ok, errors?, memoryUpdate?}
SMEJJ_AUTONOMOUS_LOOP_ENABLED=NO
SMEJJ_WORKER_DISPATCH_URL=
SMEJJ_WORKER_TOKEN_SECRET=
SMEJJ_WORKER_REQUEST_TIMEOUT_MS=3900000
SMEJJ_MAX_PARALLEL_JOBS=1
SMEJJ_WORKER_REQUIRE_REPO_ALLOWLIST=NO
SMEJJ_WORKER_GITHUB_OWNER_ALLOWLIST=
# Per-job Salad CPU sandbox. Runtime activation remains fail-closed unless the
# reviewed release ID, attested runtime, authenticated ingress, durable global
# budget and crash-safe capacity reconciliation are all configured.
SMEJJ_EPHEMERAL_WORKER_ENABLED=NO
SMEJJ_EPHEMERAL_SECURITY_REVIEW_ID=
SMEJJ_EPHEMERAL_TRUSTED_REPOS_ONLY=NO
SMEJJ_EPHEMERAL_RUNTIME_SOURCE_REPOSITORY=SmejjCom/smejj-control
SMEJJ_EPHEMERAL_WORKER_SOURCE_BASE=
SMEJJ_EPHEMERAL_WORKER_BOOTSTRAP_SHA256=
SMEJJ_EPHEMERAL_WORKER_MANIFEST_SHA256=
SMEJJ_EPHEMERAL_RUNTIME_IDRIVE_KEY=
SMEJJ_EPHEMERAL_RUNTIME_IDRIVE_SHA256=
SMEJJ_CONTROL_ORIGIN=https://smejj.com
SMEJJ_EPHEMERAL_WORKER_VCPU=4
SMEJJ_EPHEMERAL_WORKER_MEMORY_MB=8192
SMEJJ_EPHEMERAL_WORKER_STORAGE_BYTES=32212254720
SMEJJ_EPHEMERAL_WORKER_SHM_MB=1024
SMEJJ_EPHEMERAL_WORKER_STARTUP_TIMEOUT_MS=720000
SMEJJ_EPHEMERAL_WORKER_POLL_INTERVAL_MS=5000
SMEJJ_EPHEMERAL_RECOVERY_MAX_LEASES=100
SMEJJ_EPHEMERAL_RECOVERY_CONCURRENCY=4
# Optional GitHub App for repository-scoped private read clones only.
# Keep the PKCS#8 private key base64 value exclusively in the secure external
# env file or runtime secret store; never place it in the project workspace.
SMEJJ_GITHUB_APP_ID=
SMEJJ_GITHUB_APP_INSTALLATION_ID=
SMEJJ_GITHUB_APP_PRIVATE_KEY_BASE64=
SMEJJ_GITHUB_OWNER_ALLOWLIST=
SMEJJ_GITHUB_REPOSITORY_ALLOWLIST=
# A separate GitHub App is required for publishing. It is restricted to an
# exact public-repository allowlist because private Draft PRs are unavailable on
# GitHub Free. The model worker never receives these credentials.
SMEJJ_GITHUB_PUBLISHER_ENABLED=NO
CONFIRM_GITHUB_PUBLISH=NO
SMEJJ_GITHUB_PUBLISHER_APP_ID=
SMEJJ_GITHUB_PUBLISHER_APP_INSTALLATION_ID=
SMEJJ_GITHUB_PUBLISHER_APP_PRIVATE_KEY_BASE64=
SMEJJ_GITHUB_PUBLISH_REPOSITORY_ALLOWLIST=
SMEJJ_WORKER_MAX_MODEL_ACTIONS=25
SMEJJ_WORKER_MODEL_MAX_TOKENS=8192
SMEJJ_WORKER_MAX_RUNTIME_MS=3300000

# Public model abuse limits per running bridge/control replica. These protect
# bursts but do not replace a durable provider-side spending cap.
SMEJJ_PUBLIC_AI_RATE_PER_MINUTE=12
SMEJJ_CONTROL_AI_RATE_PER_MINUTE=120
SMEJJ_PUBLIC_AI_GLOBAL_RATE_PER_MINUTE=120

# smejj 1.0 training capture is fail-closed. Enabling capture is not sufficient:
# explicit consent, repository rights, provider rights, every quality gate,
# --- smejj fast 1.0 (eigenes Modell, selbst gehostet auf Salad-GPU) ---
# Zweck: Profil "fast" (kurze Chat-Anfragen) in <1 s statt 4-5 s ueber die Z.ai-API.
# Basis: Qwen3-Coder-30B-A3B-Instruct (Apache-2.0, MoE 30,5B gesamt / ~3B aktiv).
# Gewichte: GGUF UD-Q4_K_XL (17,7 GB) in IDrive e2 unter
#   model-files/smejj-1-0/original/Qwen3-Coder-30B-A3B-Instruct-UD-Q4_K_XL.gguf
# FAIL-CLOSED: Alle drei Werte muessen gesetzt sein, sonst bleibt GLM-5.2 zustaendig.
# Kosten entstehen NUR, wenn die Salad Container Group laeuft (pay-per-use).
SMEJJ_FAST_1_ENABLED=NO
# Adresse der Container Group smejj-fast-1 (llama.cpp-Server, OpenAI-kompatibel):
#   https://cacao-wasabi-57etuqmqg1gbbsid.salad.cloud/v1
# Bewusst NICHT vorbelegt: erst eintragen, wenn der Dienst wirklich laufen soll.
SMEJJ_LLM_FAST_BASE_URL=
SMEJJ_LLM_FAST_API_KEY=
SMEJJ_LLM_FAST_MODEL=smejj-fast-1
# Salad Container Gateway erwartet diesen Header statt Bearer (Default der Registry).
SMEJJ_LLM_FAST_HEADER=Salad-Api-Key
# Auto-Routing muss aktiv sein, damit das Profil "fast" ueberhaupt greifen kann.
SMEJJ_MODEL_AUTO_ENABLED=NO

# privacy sanitization, immutable IDrive writes and both 32-byte keys are required.
SMEJJ_TRAINING_CAPTURE_ENABLED=NO
SMEJJ_TRAINING_ENCRYPTION_KEY_ID=
SMEJJ_TRAINING_ENCRYPTION_KEY_B64=
SMEJJ_TRAINING_FINGERPRINT_KEY_ID=
SMEJJ_TRAINING_FINGERPRINT_KEY_B64=
# Ed25519: PKCS#8 private DER and SPKI public DER, each strict base64.
# The private key remains on the evidence issuer; workers receive only public.
SMEJJ_TRAINING_EVIDENCE_SIGNING_KEY_ID=
SMEJJ_TRAINING_EVIDENCE_PRIVATE_KEY_B64=
SMEJJ_TRAINING_EVIDENCE_PUBLIC_KEY_B64=
# Separate Ed25519 keypair for immutable record/readback proof receipts.
SMEJJ_TRAINING_RECORD_PROOF_SIGNING_KEY_ID=
SMEJJ_TRAINING_RECORD_PROOF_PRIVATE_KEY_B64=
SMEJJ_TRAINING_RECORD_PROOF_PUBLIC_KEY_B64=
# Separate authenticated consent service. Keep disabled until the reviewed
# privacy notice hash, two distinct 32-byte HMAC keys and IDrive e2 are ready.
SMEJJ_TRAINING_CONSENT_API_ENABLED=NO
# Pinned 2026-07-17: SHA-256 of the live https://smejj.com/datenschutz.html
# (section 9 "Trainingsdaten fuer smejj 1.0", 9705 bytes, verified live==repo).
SMEJJ_TRAINING_PRIVACY_NOTICE_SHA256=ecf29df1f5f01657074eccfd77c3a5acd40f52b4cfd5d5be3594385788390650
SMEJJ_TRAINING_CONSENT_SIGNING_KEY_ID=
SMEJJ_TRAINING_CONSENT_SIGNING_KEY_B64=
SMEJJ_TRAINING_CONSENT_BINDING_KEY_ID=
SMEJJ_TRAINING_CONSENT_BINDING_KEY_B64=

# Dedicated least-privilege IDrive e2 writer for encrypted training objects.
# These credentials must not fall back to the general IDRIVE_E2_* credentials.
IDRIVE_E2_TRAINING_ENDPOINT=https://s3.us-west-2.idrivee2.com
IDRIVE_E2_TRAINING_REGION=us-west-2
IDRIVE_E2_TRAINING_ACCESS_KEY=
IDRIVE_E2_TRAINING_SECRET_KEY=
IDRIVE_E2_TRAINING_BUCKET=smejj-app
IDRIVE_E2_TRAINING_ALLOWED_PREFIXES=training/sanitized/candidates/,training/quarantine/,training/consents/,training/evidence/,training/record-proofs/,training/probes/
IDRIVE_E2_TRAINING_MAX_OBJECT_BYTES=1048576
IDRIVE_E2_TRAINING_TIMEOUT_MS=5000
IDRIVE_E2_TRAINING_RECOVERY_ATTEMPTS=3
IDRIVE_E2_TRAINING_RETRY_DELAY_MS=100

# Separate evidence-attestor principal. It is limited to immutable Task Capsule
# readback/proof under jobs/ and must never reuse the training-data principal.
IDRIVE_E2_TRAINING_ATTESTOR_ENDPOINT=https://s3.us-west-2.idrivee2.com
IDRIVE_E2_TRAINING_ATTESTOR_REGION=us-west-2
IDRIVE_E2_TRAINING_ATTESTOR_ACCESS_KEY=
IDRIVE_E2_TRAINING_ATTESTOR_SECRET_KEY=
IDRIVE_E2_TRAINING_ATTESTOR_BUCKET=smejj-app
IDRIVE_E2_TRAINING_ATTESTOR_MAX_OBJECT_BYTES=1048576
IDRIVE_E2_TRAINING_ATTESTOR_TIMEOUT_MS=5000
IDRIVE_E2_TRAINING_ATTESTOR_RECOVERY_ATTEMPTS=3
IDRIVE_E2_TRAINING_ATTESTOR_RETRY_DELAY_MS=100

# Real conditional-write probe: creates one immutable non-training object.
# Keep disabled unless both opt-ins are set for a supervised probe run.
IDRIVE_E2_TRAINING_PROBE_PREFIX=training/probes/conditional-writer/
SMEJJ_TRAINING_IDRIVE_PROBE_ENABLED=NO
SMEJJ_TRAINING_IDRIVE_PROBE_CONFIRM=

# Stateless coding worker. The source URL must be pinned to one 40-character
# commit SHA. The worker receives only short-lived per-job tokens.
SMEJJ_CONTROL_ORIGIN=
SMEJJ_WORKER_SOURCE_BASE=
SMEJJ_CONTROL_OVERLAY_BASE=
SMEJJ_COMBINED_WORKER_SOURCE_BASE=

# Optional draft-PR publication after explicit human approval. Keep unset for
# diff-only operation; never expose this value to repository child processes.
SMEJJ_GITHUB_TOKEN=

# --- Dauertrainings-Schleife (workers/smejj-lora-loop) ---
# ALLE Schalter fail-closed. Ohne Angabe antwortet nur /health, es entsteht
# keine Sekunde GPU-Zeit. Das Einschalten kostet Geld: siehe die Kostentabelle
# in workers/smejj-lora-loop/README.md (RTX 3090 = 180 USD/Monat bei
# Dauerbetrieb, gemessen im Salad-Konto am 2026-08-01).
SMEJJ_LORA_LOOP_ENABLED=NO
SMEJJ_LORA_TRAINING_ENABLED=NO
SMEJJ_LORA_NOTAUS=NO
# rtx3090 | rtxa5000 | rtx4090 | rtx5090
SMEJJ_LORA_GPU_KLASSE=
SMEJJ_LORA_MAX_USD_GESAMT=
SMEJJ_LORA_MAX_ZYKLUS_MINUTEN=45
SMEJJ_LORA_MAX_ZYKLEN=
# Referenz der SCHRIFTLICHEN Betreiber-Freigabe. Ohne diese drei Werte sperrt
# das Freigabe-Tor jeden Zyklus (Rote Liste: GPU-Zeit ist kostenpflichtig).
# Die Klasse muss zur gebuchten passen und der Betrag die echten Monatskosten
# decken — eine 3090-Freigabe deckt keine 5090.
SMEJJ_LORA_FREIGABE_ID=
SMEJJ_LORA_FREIGABE_GPU_KLASSE=
SMEJJ_LORA_FREIGABE_MONATSBETRAG_USD=
# Basismodell fuer das Training. MUSS safetensors sein — auf einer GGUF-Q4-Datei
# laesst sich kein LoRA trainieren (siehe README).
SMEJJ_LORA_BASIS_HF_REPO=
SMEJJ_LORA_BASIS_REVISION=
SMEJJ_LORA_BASIS_LIZENZ=
SMEJJ_LORA_DATENSATZ_SCHLUESSEL=
SMEJJ_LORA_DATENSATZ_MANIFEST=
SMEJJ_LORA_TRAINER_URL=
SMEJJ_LORA_TRAINER_KEY=
