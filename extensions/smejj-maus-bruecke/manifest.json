{
  "manifest_version": 3,
  "name": "smejj.com Maus-Bruecke",
  "version": "0.1.0",
  "description": "Laesst die Maus von smejj.com den echten Chrome bedienen - nur auf Seiten, die der Betreiber sichtbar freigegeben hat.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "hintergrund.js",
    "type": "module"
  },
  "action": {
    "default_title": "smejj.com Maus-Bruecke",
    "default_popup": "freigabe.html"
  },
  "externally_connectable": {
    "matches": ["https://smejj.com/*"]
  }
}
