FROM mcr.microsoft.com/playwright:v1.45.3-jammy

WORKDIR /app
COPY package.json /app/package.json
RUN PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm install --omit=dev --no-audit --no-fund playwright@1.45.3
COPY workers/remote-browser/worker.js /app/remote-browser/worker.js
COPY workers/remote-browser/session-engine.js /app/remote-browser/session-engine.js
# Der virtuelle Bildschirm. OHNE diese Zeile scheitert der Import in
# session-engine.js, das Laden der Engine wirft, und der Worker antwortet auf
# JEDE Sitzung mit 503 session_engine_unavailable — der Grund steht nirgends,
# weil der Aufrufer den Ladefehler verschluckt (live gemessen 2026-08-21).
COPY workers/remote-browser/bildschirm.mjs /app/remote-browser/bildschirm.mjs
# Der Selektor-Aufloeser der Maus wird MITBENUTZT, nicht nachgebaut: der
# Panel-Browser soll Elemente genauso finden wie die Maus. Zwei Aufloeser
# waeren zwei Verhalten, und das schwaechere faellt erst live auf.
COPY workers/maus-engine/selector.mjs /app/maus-engine/selector.mjs
# Der Beobachter ebenso: die Maus muss im Panel DENSELBEN Seitenzustand
# sehen wie in ihrem eigenen Browser, sonst entscheidet sie dort anders.
COPY workers/maus-engine/observer.mjs /app/maus-engine/observer.mjs
# Das ARIA-Auge (ZCode-Vorbild): Chromiums Bedienbaum statt Selektorliste.
# Fehlt diese Zeile, wirft der Import in session-engine.js und der Worker
# antwortet auf JEDE Sitzung mit 503 — dieselbe Falle wie bei bildschirm.mjs.
COPY workers/maus-engine/aria-baum.mjs /app/maus-engine/aria-baum.mjs
COPY workers/smejj-worker /app/smejj-worker
# worker.js importiert ../process-crash-guard.mjs — ohne diese Kopie stirbt
# der Container mit ERR_MODULE_NOT_FOUND (live gemessen 2026-08-13).
COPY workers/process-crash-guard.mjs /app/process-crash-guard.mjs

ENV NODE_ENV=production
ENV PORT=8080
ENV SMEJJ_HOST=0.0.0.0

EXPOSE 8080
# HEADFUL auf virtuellem Bildschirm (2026-08-20). Google & Co. erkennen
# headless zuverlaessig und verweigern dann die Anmeldung — der Betreiber
# bekam "kein Passwortfeld". xvfb-run stellt einen echten Fensterbaum bereit,
# ohne dass ein Desktop noetig waere; Xvfb liegt im Playwright-Image bereit.
# --auto-servernum, damit parallele Sitzungen sich keine Bildschirmnummer
# streiten. SMEJJ_BROWSER_HEADLESS=true schaltet notfalls zurueck.
CMD ["node", "/app/remote-browser/worker.js"]

# Hinweis (2026-08-13, B1-Reparatur): Diese Datei ist die Wurzel-Kopie von
# workers/remote-browser/Dockerfile im Zeabur-Namensschema Dockerfile.<dienst>.
# Der fruehere Dienst zog ein nicht existierendes Registry-Abbild ("Image Pull
# Failed"); seit dieser Datei baut Zeabur direkt aus GitHub.
