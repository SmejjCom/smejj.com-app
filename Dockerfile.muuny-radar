# muuny ai radar — eigener Dienst fuer die Recherche-Schiene (Owner-Auftrag 21.09.2026).
# Getrennt vom Training (muuny-autopilot) und von der Laufzeit: eigene Warteschlange,
# eigene Grenzen, und im Betrieb hart gedeckelt (cpus 0.5, 256 MB) — die App hat Vorrang.
# Keine npm-Abhaengigkeiten, nur Node-Bordmittel plus die geprueften smejj-Bausteine
# (S3-Signierer, BM25-Index, Fremdinhalt-Filter). Geprueft mit
# `node scripts/check-muuny-abbild.mjs Dockerfile.muuny-radar workers/muuny-radar/server.mjs`.
FROM node:22-slim
ENV NODE_ENV=production PORT=8097
WORKDIR /app
COPY package.json ./
COPY workers/muuny-radar ./workers/muuny-radar
COPY workers/muuny-autopilot/e2.js ./workers/muuny-autopilot/e2.js
COPY workers/muuny-autopilot/lager.js ./workers/muuny-autopilot/lager.js
COPY control-server/src/storage/s3Signer.js ./control-server/src/storage/s3Signer.js
COPY control-server/src/shared/hash.js ./control-server/src/shared/hash.js
COPY control-server/src/rag/bm25Index.js ./control-server/src/rag/bm25Index.js
COPY control-server/src/rag/fremdinhaltFilter.js ./control-server/src/rag/fremdinhaltFilter.js
# Env: IDRIVE_E2_* (Lager), MUUNY_RADAR_ADMIN_KEY (Admin), MUUNY_DIENST_SCHLUESSEL (Wissenssuche),
#      MUUNY_PULS_URL / MUUNY_PULS_TOKEN (Puls an den con.ax-Admin), MUUNY_RADAR_NOTAUS=YES (Notaus).
USER node
EXPOSE 8097
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:'+(process.env.PORT||8097)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
CMD ["node", "workers/muuny-radar/server.mjs"]
