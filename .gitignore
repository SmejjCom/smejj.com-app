.env
.env.*
!.env.example

# Never store model weights, downloaded checkpoints, or generated manifests in Git.
model-files/
models/
!idrive-layout/manifests/models/
!idrive-layout/manifests/models/registry.json
*.safetensors
*.gguf
*.bin
*.pt
*.pth
*.ckpt
*.onnx
*.sha256
checksums.txt

# Lokale Rollback- und Upload-Artefakte — gehoeren auf IDrive e2, nie ins Git
backups/
UPLOAD-ZU-IDRIVE/
# Deploy-Pakete (Server-Kontext, Rollback-Archive): immer IDrive e2, nie GitHub
*.tar.gz
*.tgz

# Local temporary output
.DS_Store
node_modules/
dist/
coverage/
tmp/
temp/
.wrangler/
.pnpm-store/
*.xlsx
.~lock.*#
!idrive-layout/manifests/models/**
scripts/model-management/run_glm_fp8_contabo_transfer 2.sh

# Persoenliche Session-Einstellungen bleiben lokal
.claude/settings.local.json

# Generierte Design-Mockups (Einzeldatei > 800 Zeilen, kein Code)
docs/mockups/*.html

# Python-Bytecode-Cache der Worker — wird bei jedem Lauf neu erzeugt, gehoert nie ins Git
__pycache__/

# npm-Lock ist ein Fremdkoerper: das Repo fuehrt pnpm-lock.yaml (Capsule Nr. 54, 24.08.)
/package-lock.json

# pdf.js-Worker (1,27 MB): liegt als zwei Teile im Repo (Regel: keine Datei ueber 1 MB),
# die ganze Datei entsteht per "npm run build:pdfjs-worker" und wird nie eingecheckt.
public/vendor/pdfjs/pdf.worker.min.js
public/assets/vendor/pdfjs/pdf.worker.min.js
