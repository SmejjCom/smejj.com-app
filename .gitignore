.env
.env.*
!.env.example

# Never store model weights, downloaded checkpoints, or generated manifests in Git.
/model-files/
/models/
*.safetensors
*.gguf
*.bin
*.pt
*.pth
*.ckpt
*.onnx
*.sha256
checksums.txt

# Local temporary output
.DS_Store
node_modules/
dist/
coverage/
tmp/
temp/

# Rollback-Kopien gehoeren auf IDrive e2, nicht in Git (2026-07-15)
/backups/
# Transiente Upload-Hilfskopien
/UPLOAD-ZU-GITHUB/
# Control-Release-Artefakte liegen auf IDrive e2 (Object Brain = einziger Speicher
# fuer grosse Dateien laut FREE_ONLY_MASTER_POLICY). Dieser Ordner ist nur die
# transiente Staging-Kopie fuer den Konsolen-Upload — gehoert nie in Git
# (Free-Tier: kein LFS, kein Storage). Nachgetragen 2026-07-17: analog zu
# UPLOAD-ZU-GITHUB, war versehentlich nicht ignoriert (check:security schlug an).
/UPLOAD-ZU-IDRIVE/
