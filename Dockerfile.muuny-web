# muuny.com — Web-Dienst: Anmeldung per E-Mail-Code, Chat, Daumen hoch, Einwilligung
# (Owner-Freigabe 23.09.2026). Keine npm-Abhaengigkeiten, nur Node-Bordmittel.
# Haelt die Schluessel fuer Autopilot und Laufzeit; der Browser sieht sie nie.
# Geprueft mit `node scripts/check-muuny-abbild.mjs Dockerfile.muuny-web workers/muuny-web/server.mjs`.
FROM node:22-slim
ENV NODE_ENV=production PORT=8098
WORKDIR /app
COPY package.json ./
COPY workers/muuny-web ./workers/muuny-web
USER node
EXPOSE 8098
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:'+(process.env.PORT||8098)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
CMD ["node", "workers/muuny-web/server.mjs"]
